# Copy this file to .env on the server and fill it in. Never commit .env.
PORT=3000
# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_KEY=change-me
# Shown to customers who choose bank transfer
BANK_DETAILS=Prevoir, Bank name, Account name, Account number, Branch
# Where the SQLite file lives. Keep it on a disk that survives restarts.
DB_PATH=./data/prevoir.db

# ---- Online payments (SSLCommerz: bKash, Nagad, Rocket, cards, net banking) ----
# Leave these empty and the "Pay online" option stays hidden.
# Sandbox: register free at https://developer.sslcommerz.com/registration/ and copy the test store id and password.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# sandbox (test money) or live (real money). Only use live after SSLCommerz approves your merchant account.
SSLCOMMERZ_MODE=sandbox
# Your public site address, no trailing slash. The payment page sends customers back here.
PUBLIC_URL=https://yourdomain.com
